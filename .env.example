# ==============================================================================
# VoxPulse Voice Attribute Inference Service - Environment Configuration Template
# ==============================================================================

# Application Settings
APP_NAME="VoxPulse Voice Attribute Inference Service"
APP_VERSION="0.1.0"
DEBUG=false
HOST=0.0.0.0
PORT=8000

# Device & Acceleration ('cpu' or 'cuda')
DEVICE=cpu

# Audio Normalization Settings
TARGET_SAMPLE_RATE=16000
MAX_AUDIO_SIZE_BYTES=26214400  # 25 MB
MIN_AUDIO_DURATION_SECONDS=0.5
MAX_AUDIO_DURATION_SECONDS=300.0  # 5 minutes

# Audio Quality & VAD Pipeline Thresholds
MIN_SPEECH_DURATION_SECONDS=1.5
MIN_SPEECH_RATIO=0.35
MIN_RMS_ENERGY=0.005
MAX_CLIPPING_RATIO=0.05
MIN_SNR_DB=6.0
MAX_SILENCE_RATIO=0.65

# Model Confidence Thresholds
GENDER_CONFIDENCE_THRESHOLD=0.60
AGE_CONFIDENCE_THRESHOLD=0.40

# Model Paths & Pretraining
MODEL_WEIGHTS_DIR=model_weights
SPEECHBRAIN_CACHE_DIR=pretrained_models
ENABLE_SPEECHBRAIN_DOWNLOAD=true
REQUIRE_TRAINED_MODELS=false

# WebSocket Streaming Settings
STREAM_CHUNK_BYTES=4096
STREAM_MIN_INFERENCE_SECONDS=1.5
STREAM_INFERENCE_INTERVAL_SECONDS=1.5
STREAM_MAX_BUFFER_SECONDS=60.0
